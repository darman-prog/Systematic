rules_version = '2';
// Reglas de Firestore (ADR 008): un documento por usuario en estudiantes/{uid}.
// Solo el dueño autenticado puede leerlo o escribirlo; el resto queda denegado por defecto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /estudiantes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
