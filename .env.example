# Firebase (proyecto web): completar para habilitar la cuenta y la sincronización.
# Sin estas claves la app funciona solo en local y la pantalla de cuenta se oculta.
# Las claves web de Firebase son identificadores públicos (no secretos); la seguridad real
# vive en las reglas de Firestore (firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
